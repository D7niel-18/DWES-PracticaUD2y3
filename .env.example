# Copia este archivo como ".env" y rellena tus propios valores.
# NUNCA subas el archivo ".env" al repositorio.

# Puerto donde escuchará el servidor (número entre 1 y 65535)
PORT=3000

# Entorno de ejecución: development, test o production
NODE_ENV=development

# Texto largo y aleatorio para firmar las sesiones (mínimo 16 caracteres)
SESSION_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
